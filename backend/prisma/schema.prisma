generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model OperationRecord {
  id         Int      @id @default(autoincrement())
  moduleName String
  ownerName  String
  status     String
  metric     String
  createdAt  DateTime @default(now())
}

enum FlowType {
  PURCHASE_IN
  SALE_OUT
}

enum FlowStatus {
  NORMAL
  ABNORMAL
  PENDING
}

model StoreInventoryFlow {
  id          Int        @id @default(autoincrement())
  storeName   String
  flowNo      String
  flowType    FlowType
  productName String
  sku         String
  quantity    Int
  operator    String
  status      FlowStatus
  remark      String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}
